
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07110e">
<meta name="description" content="Imperial Launcher - A modern Minecraft launcher">
<title>Imperial Launcher</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --bg:#07110e;
    --panel:#0b1712;
    --green:#6ee7a7;
    --text:#eef5ef;
    --muted:#94a69a;
    --border:rgba(168,205,183,.13);
}

* {box-sizing:border-box;margin:0;padding:0}

html {scroll-behavior:smooth}

body {
    background:var(--bg);
    color:var(--text);
    font-family:"Vazirmatn",sans-serif;
    line-height:1.8;
}

body[dir="ltr"] {font-family:"DM Sans",sans-serif}

a {color:inherit;text-decoration:none}
button {font:inherit;cursor:pointer}

.container {
    width:min(1120px,calc(100% - 40px));
    margin:auto;
}

/* HEADER */

header {
    width:min(1240px,calc(100% - 40px));
    height:80px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--border);
    position:relative;
    z-index:10;
}

.logo {
    display:flex;
    align-items:center;
    gap:10px;
}

.logo-icon {
    width:40px;
    height:40px;
    display:grid;
    place-items:center;
    color:var(--green);
    background:#10251a;
    border:1px solid #28563d;
    font-size:24px;
    font-weight:800;
    clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);
}

.logo strong {
    display:block;
    font:800 12px "DM Sans";
    letter-spacing:2px;
}

.logo small {
    display:block;
    color:#829188;
    font:8px "DM Sans";
    letter-spacing:1px;
}

nav {display:flex;gap:25px}

nav a {
    color:#a9b7ae;
    font-size:12px;
    transition:.2s;
}

nav a:hover {color:var(--green)}

.header-actions {
    display:flex;
    align-items:center;
    gap:10px;
}

button.lang {
    background:var(--panel);
    color:var(--green);
    border:1px solid var(--border);
    border-radius:7px;
    padding:8px 12px;
}

.menu {
    display:none;
    background:var(--panel);
    color:var(--green);
    border:1px solid var(--border);
    border-radius:7px;
    padding:7px 12px;
}

/* BUTTONS */

.btn {
    display:inline-flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    padding:11px 17px;
    border-radius:7px;
    font-size:12px;
    font-weight:700;
    transition:.2s;
}

.btn:hover {transform:translateY(-2px)}

.primary {
    background:var(--green);
    color:#062015;
}

.primary:hover {background:#91f2bb}

.secondary {
    border:1px solid var(--border);
    color:white;
}

/* HERO */

.hero {
    min-height:570px;
    display:grid;
    grid-template-columns:.9fr 1.1fr;
    align-items:center;
    gap:45px;
    padding-top:65px;
    padding-bottom:65px;
}

.eyebrow {
    color:#a8c2b1;
    font-size:10px;
    letter-spacing:1px;
}

.dot {
    width:7px;
    height:7px;
    display:inline-block;
    background:var(--green);
    border-radius:50%;
    box-shadow:0 0 10px var(--green);
    margin-inline-end:7px;
}

.hero h1 {
    font-size:clamp(36px,5vw,60px);
    line-height:1.4;
    margin:20px 0;
    font-weight:800;
}

.green {color:var(--green)}

.hero p {
    color:var(--muted);
    max-width:450px;
    font-size:13px;
    line-height:2.2;
    margin-bottom:25px;
}

.hero-buttons {
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.hero-note {
    margin-top:25px;
    color:#83958a;
    font-size:10px;
}

/* HERO ART */

.hero-art {
    height:360px;
    border:1px solid var(--border);
    border-radius:15px;
    position:relative;
    overflow:hidden;
    background:linear-gradient(145deg,#14261c,#09130f);
}

.art-header,.art-footer {
    position:absolute;
    left:22px;
    right:22px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:2;
}

.art-header {top:20px;font:10px "DM Sans"}

.status {color:var(--green);font-size:9px}

.landscape {
    position:absolute;
    inset:60px 0 75px;
    overflow:hidden;
    background:
    radial-gradient(circle at 70% 35%,#405d41,transparent 35%),
    linear-gradient(#172b20,#09140e);
}

.moon {
    position:absolute;
    width:85px;
    height:85px;
    top:30px;
    right:20%;
    border-radius:50%;
    background:rgba(190,220,190,.12);
}

.mountain {
    position:absolute;
    bottom:-40px;
    width:120%;
    height:80%;
}

.back {
    background:#20392a;
    clip-path:polygon(0 70%,30% 35%,48% 65%,70% 20%,100% 70%,100% 100%,0 100%);
}

.front {
    background:#0b1c12;
    clip-path:polygon(0 60%,35% 20%,60% 65%,80% 30%,100% 60%,100% 100%,0 100%);
}

.tower {
    position:absolute;
    width:42px;
    height:70px;
    right:28%;
    bottom:25%;
    background:#1b2d20;
    border:2px solid #344b36;
}

.tower span {
    width:7px;
    height:10px;
    position:absolute;
    top:15px;
    left:8px;
    background:#9dbb8d;
}

.tower span:nth-child(2) {left:24px}
.tower span:nth-child(3) {top:40px;left:16px}

.art-footer {bottom:18px;align-items:end}

.art-footer small {
    display:block;
    color:#91a69a;
    font-size:8px;
}

.art-footer strong {
    display:block;
    font:800 28px "DM Sans";
}

.art-caption {
    font:8px/2 "DM Sans";
    color:#82978a;
    letter-spacing:2px;
    text-align:end;
}

/* SECTIONS */

section.content {padding-top:90px;padding-bottom:90px}

.section-title {
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    margin-bottom:30px;
}

.section-title h2 {
    font-size:29px;
    margin-top:10px;
}

.section-title p {
    color:var(--muted);
    font-size:12px;
    max-width:350px;
}

/* FEATURES */

.features-grid {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.feature-card {
    position:relative;
    padding:25px;
    min-height:220px;
    background:linear-gradient(145deg,#0d1b14,#09130f);
    border:1px solid var(--border);
    border-radius:12px;
    transition:.2s;
}

.feature-card:hover {
    transform:translateY(-4px);
    border-color:rgba(110,231,167,.4);
}

.feature-icon {
    width:42px;
    height:42px;
    display:grid;
    place-items:center;
    background:rgba(73,207,133,.12);
    color:var(--green);
    border-radius:9px;
    font-size:22px;
    margin-bottom:20px;
}

.purple {color:#b4a0ff;background:rgba(153,130,245,.12)}
.gold {color:#dfc47e;background:rgba(221,190,112,.12)}

.number {
    position:absolute;
    top:30px;
    left:25px;
    color:#718679;
    font:9px "DM Sans";
}

.feature-card h3 {font-size:16px;margin-bottom:8px}
.feature-card p {color:var(--muted);font-size:11px}

/* DOWNLOAD */

.download-box {
    display:flex;
    align-items:center;
    gap:22px;
    padding:30px;
    border:1px solid rgba(110,231,167,.2);
    border-radius:13px;
    background:radial-gradient(circle at 10% 50%,rgba(65,180,113,.15),transparent 45%),#0c1911;
}

.download-icon {
    width:60px;
    height:60px;
    display:grid;
    place-items:center;
    border:1px solid rgba(110,231,167,.4);
    color:var(--green);
    border-radius:12px;
    font-size:28px;
    font-weight:800;
}

.download-text {flex:1}
.download-text h2 {font-size:22px;margin:5px 0}
.download-text p {font-size:11px;color:var(--muted)}

/* NEWS */

.news-grid {
    display:grid;
    grid-template-columns:1.2fr 1fr;
    gap:15px;
}

.news-card {
    display:grid;
    grid-template-columns:1fr 1fr;
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
    background:var(--panel);
    min-height:220px;
}

.news-image {
    background:radial-gradient(circle,rgba(67,193,122,.2),transparent 60%),#102219;
    display:grid;
    place-items:center;
    position:relative;
}

.news-image span {font-size:65px;color:var(--green)}

.news-image small {
    position:absolute;
    bottom:12px;
    left:12px;
    color:#91a69a;
    font:8px "DM Sans";
}

.community {background:#171927}
.community span {color:#b4a0ff}

.news-content {padding:20px}
.news-label {color:var(--green);font:9px "DM Sans"}
.news-content h3 {font-size:18px;margin:12px 0 5px}
.news-content p {color:var(--muted);font-size:11px;margin-bottom:15px}
.news-content .green {font-size:10px}

.coming-soon {color:#b4a0ff;font-size:10px}
.powered {color:#91a69a;font:10px "DM Sans"}
.powered b {color:var(--green)}

/* ABOUT */

.about-section {
    border-block:1px solid var(--border);
    background:#0a1711;
}

.about-content {
    padding-top:70px;
    padding-bottom:70px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
}

.about-content h2 {font-size:30px;margin-top:12px}
.about-content p {color:var(--muted);font-size:12px;line-height:2.4}

/* FAQ */

.faq-list {border-top:1px solid var(--border)}
details {border-bottom:1px solid var(--border);padding:20px 5px}
summary {cursor:pointer;font-size:13px;font-weight:600}
details p {color:var(--muted);font-size:11px;margin-top:12px}

/* FOOTER */

footer {
    border-top:1px solid var(--border);
    padding:25px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

footer span,footer>a:last-child {
    color:#83958a;
    font:10px "DM Sans";
}

/* RESPONSIVE */

@media(max-width:850px) {
    nav {gap:12px}
    .hero {gap:25px}
    .news-grid {grid-template-columns:1fr}
}

@media(max-width:650px) {
    header {height:70px}
    .menu {display:block;margin-inline-start:auto}

    nav {
        display:none;
        position:absolute;
        top:70px;
        right:0;
        left:0;
        padding:15px;
        background:var(--panel);
        border:1px solid var(--border);
        border-radius:10px;
        flex-direction:column;
        z-index:10;
    }

    nav.open {display:flex}
    .header-actions {margin-inline-start:10px}
    .header-actions .primary {display:none}

    .hero {
        grid-template-columns:1fr;
        padding-top:50px;
    }

    .hero-art {height:290px}
    .hero h1 {font-size:39px}

    .section-title {
        align-items:flex-start;
        flex-direction:column;
    }

    .features-grid {grid-template-columns:1fr}
    .download-box {flex-wrap:wrap}
    .download-text {min-width:180px}
    .download-box .btn {width:100%}

    .news-card {grid-template-columns:1fr}
    .news-image {min-height:140px}

    .about-content {
        grid-template-columns:1fr;
        gap:20px;
    }

    footer {flex-wrap:wrap}
}

body[dir="ltr"] .number {left:auto;right:25px}
body[dir="ltr"] .news-image small {left:auto;right:12px}
</style>
</head>

<body>

<header>

    <a href="#home" class="logo">
        <div class="logo-icon">I</div>
        <div>
            <strong>IMPERIAL</strong>
            <small>MINECRAFT LAUNCHER</small>
        </div>
    </a>

    <button class="menu" id="menu">☰</button>

    <nav id="nav">
        <a href="#home" data-fa="خانه" data-en="Home">خانه</a>
        <a href="#features" data-fa="امکانات" data-en="Features">امکانات</a>
        <a href="#news" data-fa="اخبار" data-en="News">اخبار</a>
        <a href="#about" data-fa="درباره ما" data-en="About">درباره ما</a>
        <a href="#faq" data-fa="سؤالات متداول" data-en="FAQ">سؤالات متداول</a>
    </nav>

    <div class="header-actions">
        <button class="lang" id="language">EN</button>

        <a class="btn primary"
           href="https://github.com/resurect63/Imperial-Launcher/releases/latest"
           target="_blank">
            <span data-fa="دانلود لانچر" data-en="Download Launcher">دانلود لانچر</span> ↗
        </a>
    </div>

</header>

<main>

<!-- HERO -->

<section class="hero container" id="home">

    <div class="hero-content">

        <div class="eyebrow">
            <span class="dot"></span>
            <span data-fa="لانچر مدرن ماینکرفت" data-en="A Modern Minecraft Launcher">
                لانچر مدرن ماینکرفت
            </span>
        </div>

        <h1>
            <span data-fa="ماجراجویی تو،" data-en="YOUR WORLD,">ماجراجویی تو،</span>
            <br>
            <span class="green" data-fa="از اینجا شروع می‌شه." data-en="YOUR NEXT ERA.">
                از اینجا شروع می‌شه.
            </span>
        </h1>

        <p data-fa="نسخه‌های ماینکرفت، مودها و تجربه بازی‌ات را در یک محیط یکپارچه مدیریت کن. ساده، سریع و ساخته‌شده برای دنیای تو."
           data-en="Manage Minecraft versions, mods, and your gaming experience in one place. Simple, fast, and made for your world.">
            نسخه‌های ماینکرفت، مودها و تجربه بازی‌ات را در یک محیط یکپارچه مدیریت کن.
            ساده، سریع و ساخته‌شده برای دنیای تو.
        </p>

        <div class="hero-buttons">

            <a class="btn primary"
               href="https://github.com/resurect63/Imperial-Launcher/releases/latest"
               target="_blank">
                ▶
                <span data-fa="دریافت Imperial Launcher" data-en="Get Imperial Launcher">
                    دریافت Imperial Launcher
                </span>
                ↗
            </a>

            <a href="#features" class="btn secondary">
                <span data-fa="مشاهده امکانات" data-en="Explore Features">
                    مشاهده امکانات
                </span>
            </a>

        </div>

        <div class="hero-note">
            <span class="dot"></span>
            <span data-fa="طراحی‌شده برای Minecraft Java Edition"
                  data-en="Designed for Minecraft Java Edition">
                طراحی‌شده برای Minecraft Java Edition
            </span>
        </div>

    </div>

    <div class="hero-art">

        <div class="art-header">
            <strong>◆ IMPERIAL</strong>
            <span class="status">● LAUNCHER READY</span>
        </div>

        <div class="landscape">
            <div class="moon"></div>
            <div class="mountain back"></div>
            <div class="mountain front"></div>

            <div class="tower">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <div class="art-footer">
            <div>
                <small data-fa="نسخه انتخاب‌شده" data-en="SELECTED VERSION">نسخه انتخاب‌شده</small>
                <strong>1.21.x</strong>
                <small class="green">● READY TO CONFIGURE</small>
            </div>

            <div class="art-caption">
                YOUR WORLD<br>YOUR LEGACY
            </div>
        </div>

    </div>

</section>


<!-- FEATURES -->

<section class="content container" id="features">

    <div class="section-title">
        <div>
            <span class="eyebrow">FEATURES</span>
            <h2 data-fa="امکانات Imperial Launcher" data-en="Imperial Launcher Features">
                امکانات Imperial Launcher
            </h2>
        </div>

        <p data-fa="تمام ابزارهای موردنیاز برای مدیریت تجربه ماینکرفت."
           data-en="Everything you need to manage your Minecraft experience.">
            تمام ابزارهای موردنیاز برای مدیریت تجربه ماینکرفت.
        </p>
    </div>

    <div class="features-grid">

        <article class="feature-card">
            <div class="feature-icon">▦</div>
            <span class="number">01 / LIBRARY</span>
            <h3 data-fa="کتابخانه نسخه‌ها" data-en="Version Library">کتابخانه نسخه‌ها</h3>
            <p data-fa="نسخه‌های مختلف ماینکرفت را مدیریت و اجرا کن."
               data-en="Manage and launch different Minecraft versions.">
                نسخه‌های مختلف ماینکرفت را مدیریت و اجرا کن.
            </p>
        </article>

        <article class="feature-card">
            <div class="feature-icon purple">✦</div>
            <span class="number">02 / MODRINTH</span>
            <h3 data-fa="مودها و مودپک‌ها" data-en="Mods & Modpacks">مودها و مودپک‌ها</h3>
            <p data-fa="مودها و محتوای جدید را برای بازی خودت کشف کن."
               data-en="Discover new mods and content for your game.">
                مودها و محتوای جدید را برای بازی خودت کشف کن.
            </p>
        </article>

        <article class="feature-card">
            <div class="feature-icon gold">◉</div>
            <span class="number">03 / ACCOUNT</span>
            <h3 data-fa="حساب مایکروسافت" data-en="Microsoft Account">حساب مایکروسافت</h3>
            <p data-fa="حساب خودت را برای تجربه آنلاین به لانچر متصل کن."
               data-en="Connect your account for supported online gameplay.">
                حساب خودت را برای تجربه آنلاین به لانچر متصل کن.
            </p>
        </article>

    </div>

</section>


<!-- DOWNLOAD -->

<section class="download-box container" id="download">

    <div class="download-icon">I</div>

    <div class="download-text">
        <span class="eyebrow">READY TO PLAY?</span>

        <h2 data-fa="دنیای بعدی منتظر توئه." data-en="Your Next World Is Waiting.">
            دنیای بعدی منتظر توئه.
        </h2>

        <p data-fa="آخرین نسخه Imperial Launcher را دریافت کن."
           data-en="Get the latest Imperial Launcher release.">
            آخرین نسخه Imperial Launcher را دریافت کن.
        </p>
    </div>

    <a class="btn primary"
       href="https://github.com/resurect63/Imperial-Launcher/releases/latest"
       target="_blank">
        <span data-fa="دانلود آخرین نسخه" data-en="Download Latest Version">
            دانلود آخرین نسخه
        </span>
        ↗
    </a>

</section>


<!-- NEWS -->

<section class="content container" id="news">

    <div class="section-title">
        <div>
            <span class="eyebrow">IMPERIAL NEWS</span>
            <h2 data-fa="اخبار و به‌روزرسانی‌ها" data-en="News & Updates">
                اخبار و به‌روزرسانی‌ها
            </h2>
        </div>

        <a class="green"
           href="https://github.com/resurect63/Imperial-Launcher/releases"
           target="_blank">
            <span data-fa="تمام نسخه‌ها" data-en="All Releases">تمام نسخه‌ها</span> ↗
        </a>
    </div>

    <div class="news-grid">

        <a class="news-card"
           href="https://github.com/resurect63/Imperial-Launcher/releases/latest"
           target="_blank">

            <div class="news-image">
                <span>↻</span>
                <small>IMPERIAL / UPDATE</small>
            </div>

            <div class="news-content">
                <span class="news-label">● OFFICIAL RELEASES</span>

                <h3 data-fa="همیشه به‌روز بمان" data-en="Stay Up To Date">
                    همیشه به‌روز بمان
                </h3>

                <p data-fa="آخرین نسخه‌ها و تغییرات لانچر را دنبال کن."
                   data-en="Follow the latest launcher versions and updates.">
                    آخرین نسخه‌ها و تغییرات لانچر را دنبال کن.
                </p>

                <span class="green">VIEW RELEASES ↗</span>
            </div>

        </a>


        <div class="news-card">

            <div class="news-image community">
                <span>✦</span>
                <small>COMMUNITY / SOON</small>
            </div>

            <div class="news-content">
                <span class="coming-soon">COMING SOON</span>

                <h3>PKDev</h3>

                <p data-fa="اطلاعات بیشتر به‌زودی منتشر می‌شود."
                   data-en="More information will be available soon.">
                    اطلاعات بیشتر به‌زودی منتشر می‌شود.
                </p>

                <span class="powered">Powered by <b>Resurect</b></span>
            </div>

        </div>

    </div>

</section>


<!-- ABOUT -->

<section class="about-section" id="about">

    <div class="about-content container">

        <div>
            <span class="eyebrow">ABOUT IMPERIAL</span>

            <h2 data-fa="ساخته‌شده برای دنیای تو."
